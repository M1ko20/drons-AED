{
  "name": "beskydy-aed-drone-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Decision-support prototype: AED drone coverage simulation for the Beskydy Mountains (CZ)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fetch": "node scripts/fetch-raw.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data": "npm run data:fetch && npm run data:build",
    "check:browser": "node scripts/browser-check.mjs && node scripts/browser-check-2.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
